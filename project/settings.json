  },
  "language": {
    "source_lang": "en",
    "target_lang": "zh-CN",
    "auto_detect_source": false,
    "default_pair_by_system": true
  },
  "ocr_model_id": "win11_media_ocr",
  "ocr_model_dir": "models/ocr/rapidocr",
  "translation_model_id": "qwen2.5-1.5b-instruct-q4_k_m",
